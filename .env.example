# Supabase (DB, Auth, RLS, pgvector, Vault)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Anthropic (Primary LLM)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI (Fallback LLM + Whisper STT)
OPENAI_API_KEY=sk-proj-your-api-key-here

# DeepSeek (Budget LLM - ~90% cheaper, good quality)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Google (Gmail + Google Calendar - OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Zapier (Webhooks - one per Zap)
ZAPIER_WEBHOOK_URLS=https://hooks.zapier.com/hooks/catch/...

# CRM (TBD - Follow Up Boss / Real Geeks / kvCORE / CINC / RealScout)
CRM_API_KEY=your_crm_api_key_here
CRM_TYPE=follow_up_boss  # or real_geeks, kvcore, cinc, realscout

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=default_voice_id

# Twilio (Phone)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SerpAPI (Web Search)
SERPAPI_KEY=your_serpapi_key_here

# Railway (Backend - only needed for CLI deploys)
RAILWAY_API_TOKEN=your_railway_token

# Vercel (Frontend - only needed for CLI deploys)
VERCEL_TOKEN=your_vercel_token

# Application
ENVIRONMENT=development  # development, staging, production
DATABASE_LOG_LEVEL=info
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
